rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'teacher@example.com';
    }

    // إعدادات الموقع وحصص البوابة العامة — يقرأها الجميع، يكتبها المعلّم
    match /public/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // حصص المشتركين + الرمز العام + السعر — لا يقرأها إلا المعلّم والدوال
    match /private/{doc} {
      allow read, write: if isAdmin();
    }

    // الرموز — تُنشأ من الدوال فقط
    match /codes/{code} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // عمليات الدفع — للدوال فقط
    match /payments/{id} {
      allow read, write: if false;
    }

    // سجل الدخول — الطالب يضيف سطرًا، والمعلّم وحده يقرأ
    match /entries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['n','p','s','g','w','t'])
                    && request.resource.data.n is string && request.resource.data.n.size() <= 60
                    && request.resource.data.p is string && request.resource.data.p.size() <= 20;
      allow read, update, delete: if isAdmin();
    }
  }
}
